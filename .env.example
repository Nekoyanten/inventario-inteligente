# ---- Desarrollo ----
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Sin DATABASE_URL se usa SQLite. Con Docker:
# DATABASE_URL=postgres://inventario:inventario@localhost:5432/inventario

# ---- Producción (DEBUG=False) ----
# SECRET_KEY=<obligatoria: python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=inventario.tudominio.com
# CSRF_TRUSTED_ORIGINS=https://inventario.tudominio.com
# ADMIN_URL=panel-secreto-8f3a/          # cambia la ruta del admin de Django
# URL_SITIO=https://inventario.tudominio.com
# EMAIL_URL=smtp+tls://usuario:clave@smtp.proveedor.com:587
# DEFAULT_FROM_EMAIL=Inventario Inteligente <alertas@tudominio.com>
# CACHE_URL=redis://localhost:6379/1     # recomendado con varios servidores (límite de intentos de ingreso)

# ---- Imágenes de productos en la nube (obligatorio en Render/Docker) ----
# Cloudflare R2 (tiene nivel gratuito; revisa sus límites vigentes): crea un bucket y un token de API con permiso de lectura y escritura.
# AWS_STORAGE_BUCKET_NAME=inventario-imagenes
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://<id-de-cuenta>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=imagenes.tudominio.com   # opcional: dominio público del bucket (URLs sin firma)
# SERVIR_MEDIA_LOCAL=True                       # solo VPS con disco persistente y sin bucket

# ---- Monitoreo ----
# SENTRY_DSN=https://...@o000000.ingest.sentry.io/000000
# SENTRY_ENTORNO=produccion

